# . gitignore - Fichiers a ne PAS versionner
# Environnement Python
__pycache__/
*.pyc
venv/

# Clé API ( ne pas partager sur GitHub )
.env
# Modele ML ( trop gros pour GitHub )
models/*.pkl
# Fichiers OS
.DS_Store
Thumbs.db
# IDE
.vscode/
.idea/

# Fichiers temporaires matplotlib
*.png
!figures/*.png